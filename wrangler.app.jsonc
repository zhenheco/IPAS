// 完整版（靜態資源 + /api/* Worker + D1）設定。目前正式部署仍用 wrangler.jsonc（純靜態）。
// 切換步驟見 docs/payments.md「上線檢查清單」：
//   npx wrangler d1 create ipas         → 把 database_id 填入下方
//   npx wrangler d1 migrations apply ipas --remote -c wrangler.app.jsonc
//   npx wrangler secret put <NAME> -c wrangler.app.jsonc（清單見 .dev.vars.example）
//   npx astro build && npx wrangler deploy -c wrangler.app.jsonc
{
  "name": "ipas",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Better Auth 需要 AsyncLocalStorage 等 Node 相容 API
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // 只有 /api/* 先進 Worker；其他路徑直接由靜態資源回應（不耗用 Worker 請求）
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ipas",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://ipas.zhenhe-co.com",
    // sandbox | production；正式收款前務必先以 sandbox 完成測試
    "PAYUNI_ENV": "sandbox",
    // resend | console
    "EMAIL_PROVIDER": "resend",
    "EMAIL_FROM": "iPAS 練習 <no-reply@zhenhe-co.com>",
    "ADMIN_EMAILS": ""
  },
  "routes": [
    { "pattern": "ipas.zhenhe-co.com", "custom_domain": true },
    // exact route needed: zone has *.zhenhe-co.com/* and */* routes to another Worker that otherwise win
    { "pattern": "ipas.zhenhe-co.com/*", "zone_name": "zhenhe-co.com" }
  ]
}
