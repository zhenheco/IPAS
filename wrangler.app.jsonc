// 完整版（靜態資源 + /api/* Worker + D1）設定。目前正式部署仍用 wrangler.jsonc（純靜態）。
// 切換步驟見 docs/payments.md「上線檢查清單」：
//   D1 已建立（database_id 已填入下方）；如需重建：npx wrangler d1 create ipas
//   npx wrangler d1 migrations apply ipas --remote -c wrangler.app.jsonc
//   npx wrangler secret put <NAME> -c wrangler.app.jsonc（清單見 .dev.vars.example）
//   npm run deploy:app
{
  "name": "ipas",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // 部署前檢查 dist 不含官方題或變體題（ADR 0004）；先自行 astro build
  "build": { "command": "npm run check:dist" },
  // Better Auth 需要 AsyncLocalStorage 等 Node 相容 API
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // 只有 /api/* 先進 Worker；其他路徑直接由靜態資源回應（不耗用 Worker 請求）
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ipas",
      "database_id": "d88ccc7b-f2e4-4f14-83ea-eb90ed52704d",
      "migrations_dir": "migrations"
    }
  ],
  // 同帳號的 cf-email Worker 必須走 service binding；直接 fetch workers.dev 網址會得到 error code: 1042
  "services": [{ "binding": "CF_EMAIL", "service": "cf-email" }],
  "vars": {
    "BETTER_AUTH_URL": "https://ipas.zhenhe-co.com",
    // 收款經 zhenheco affiliate 金流微服務（本站不直接呼叫 PAYUNi）；金鑰與 webhook 秘密見 docs/payments.md
    "PAYMENT_API_BASE": "https://affiliate.1wayseo.com",
    "PAYMENT_SITE_CODE": "IPAS",
    // cf-email | console（cf-email 還需 CF_EMAIL_API_KEY 秘密）
    "EMAIL_PROVIDER": "cf-email",
    // 純位址；中繼會移除顯示名稱
    "EMAIL_FROM": "no-reply@zhenhe-co.com"
  },
  "routes": [
    { "pattern": "ipas.zhenhe-co.com", "custom_domain": true },
    // exact route needed: zone has *.zhenhe-co.com/* and */* routes to another Worker that otherwise win
    { "pattern": "ipas.zhenhe-co.com/*", "zone_name": "zhenhe-co.com" }
  ]
}
