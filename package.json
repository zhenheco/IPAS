{
  "name": "ipas-practice",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "papers": "npx tsx scripts/build-papers.ts",
    "check:dist": "npx tsx scripts/check-dist-bank.ts",
    "deploy": "env -u INCLUDE_OFFICIAL astro build && npm run check:dist && npx wrangler deploy",
    "deploy:app": "env -u INCLUDE_OFFICIAL PUBLIC_PAYWALL_ENABLED=1 PUBLIC_ADSENSE_CLIENT=ca-pub-2083860552590797 astro build && npm run check:dist && npx wrangler deploy -c wrangler.app.jsonc",
    "typecheck:worker": "tsc --noEmit -p worker",
    "test:worker": "vitest run worker"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.5",
    "better-auth": "^1.7.16",
    "hono": "^4.13.16",
    "kysely": "^0.29.8",
    "kysely-d1": "^0.4.0",
    "preact": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^26.6.6",
    "vitest": "^5.1.0"
  }
}
