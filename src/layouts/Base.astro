---
import '../styles/global.css';
const { title } = Astro.props;
const nav = [
  ['/', '首頁'], ['/practice/', '練習'], ['/exam/', '單科模考'], ['/full/', '全真模考'],
  ['/wrongbook/', '錯題本'], ['/weakness/', '弱點分析'], ['/history/', '作答歷史'], ['/settings/', '設定'],
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} | iPAS AI 應用規劃師練習</title>
  </head>
  <body>
    <header class="top">
      <a class="brand" href="/">iPAS AI 應用規劃師 · 中級</a>
      <nav aria-label="主選單">
        {nav.map(([href, label]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
      </nav>
    </header>
    <main><slot /></main>
  </body>
</html>
