---
import '../styles/global.css';
const { title } = Astro.props;
const nav = [
  ['/', '首頁'], ['/plan/', '讀書計畫'], ['/practice/', '練習'], ['/exam/', '單科模考'], ['/full/', '全真模考'],
  ['/wrongbook/', '錯題本'], ['/weakness/', '弱點分析'], ['/history/', '作答歷史'], ['/settings/', '設定'],
];
// 價目與帳號 appear only once the owner builds with PUBLIC_PAYWALL_ENABLED=1
if (import.meta.env.PUBLIC_PAYWALL_ENABLED === '1') nav.push(['/pricing/', '價目'], ['/account/', '帳號']);
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} | iPAS AI 應用規劃師練習</title>
  </head>
  <body>
    <header class="top">
      <a class="brand" href="/">iPAS AI 應用規劃師 · 初級／中級</a>
      <nav aria-label="主選單">
        {nav.map(([href, label]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-foot">
      <a href="/terms/">服務條款</a>
      <a href="/refund/">退款政策</a>
      <a href="/privacy/">隱私權政策</a>
      <p>評鑑主題與學習範圍參考：經濟部產業人才能力鑑定（iPAS）官網公告之評鑑內容（初級依 115 年度簡章 0410 版核對；以官方最新公告為準）</p>
    </footer>
  </body>
</html>
