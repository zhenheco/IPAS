---
import Article from '../../layouts/Article.astro';
import { SRC } from '../../lib/guides';
import { faqJsonLd } from '../../lib/seo';

// Answers are plain text so the same strings feed the page and the FAQPage JSON-LD.
const faq = [
  { q: 'iPAS 是什麼？', a: 'iPAS 是經濟部產業人才能力鑑定，由經濟部產業發展署推動，依產業需求設計各類職能鑑定，AI 應用規劃師是其中一項，分初級與中級。' },
  { q: 'AI 應用規劃師要先考初級才能考中級嗎？', a: '115 年度簡章沒有寫中級須先取得初級，也沒有列學歷或年資限制，只建議中級由具資通訊技術能力或 AI 開發經驗者報考。實際資格以官方簡章為準。' },
  { q: '初級要考幾科？幾分及格？', a: '初級考 L11 人工智慧基礎概論與 L12 生成式 AI 應用與規劃兩科，每科 75 分鐘、滿分 100 分、70 分及格。同一梯次兩科都考時，平均 70 分且每科不低於 60 分也算通過。' },
  { q: '中級要考幾科？證書有什麼不同？', a: '中級必考 L21 人工智慧技術應用與規劃，再從 L22 大數據處理分析與應用或 L23 機器學習技術與應用擇一，每科 90 分鐘、兩科都要 70 分。考 L22 取得數據分析證書，考 L23 取得機器學習證書。' },
  { q: '考試是紙筆還是電腦？可以帶自己的電腦嗎？', a: '是電腦化測驗，試場提供電腦，不能自帶設備。' },
  { q: '中級有程式題嗎？', a: '有。官方公告 L22、L23 含程式題，預計約占全卷 25%，題型含單選題與題組。' },
  { q: '報名費多少？', a: '原價初級每科 1,200 元、中級每科 1,500 元。115 至 116 年有優惠，初級每科 400 元、中級每科 500 元，117 年起恢復原價；弱勢身分持證明可享原價 3 折。以報名系統顯示為準。' },
  { q: '證書效期多久？', a: '初級證書永久有效；中級證書效期 5 年，屆滿前 3 個月內可申請換發，條件是 5 年內累計 48 小時以上 AI 相關訓練，工作年資每年可折抵 8 小時。' },
  { q: '單科沒過，下次要全部重考嗎？', a: '不用。70 分以上的單科成績保留三年度，例如 115 年考過的科目保留到 118 年 12 月 31 日，下次只要補考沒過的科目。' },
  { q: '有舊的巨量資料分析師或機器學習工程師證照，可以抵免嗎？', a: '可以抵免中級 L22 或 L23，但必須先考 L21 並達 70 分，抵免資格保留到 116 年底。細節見官方中級科目抵免辦法。' },
  { q: '考古題在哪裡下載？', a: 'iPAS 官網下載專區會公告部分梯次的試題。本站不轉載官方試題，提供的是依官方評鑑主題撰寫的原創模擬題。' },
  { q: '本站是 iPAS 官方網站嗎？', a: '不是。本站由振禾有限公司獨立經營，提供練習與模擬考功能，考試規則與日期以 iPAS 官方公告為準。' },
];
---
<Article path="/guide/faq/" sources={[SRC.brochure, SRC.coding, SRC.downloads, SRC.news]} jsonLd={[faqJsonLd(faq)]}>
  <p>整理考生最常問的 iPAS AI 應用規劃師問題。答案依 115 年度簡章與 iPAS 官網公告整理；更詳細的說明請看各篇考試指南。</p>
  {faq.map(({ q, a }) => <><h2>{q}</h2><p>{a}</p></>)}
  <p>還有其他問題？可以用右下角的「聯絡我們」留言，或先閱讀<a href="/guide/">考試指南</a>的其他文章。</p>
</Article>
