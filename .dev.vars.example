# 複製為 .dev.vars 供 `wrangler dev -c wrangler.app.jsonc` 使用（.dev.vars 不可提交）。
# 正式環境以 `npx wrangler secret put <NAME> -c wrangler.app.jsonc` 設定下列秘密。

# Better Auth：至少 32 字元隨機字串（openssl rand -base64 32）
BETTER_AUTH_SECRET=
# 本機開發覆寫 vars 中的網址
BETTER_AUTH_URL=http://localhost:8787

# Google OAuth（Google Cloud Console → 憑證 → OAuth 用戶端 ID；重新導向 URI：{BETTER_AUTH_URL}/api/auth/callback/google）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# zhenheco affiliate 金流微服務（本站不直接呼叫 PAYUNi，也不持有 PAYUNi 金鑰）。
# PAYMENT_API_KEY / PAYMENT_WEBHOOK_SECRET 正式環境取自 1Password「zhenheco-payment-IPAS-prod」（vault Dev），做法見 docs/payments.md。
# PAYMENT_API_BASE / PAYMENT_SITE_CODE 正式環境已寫在 wrangler.app.jsonc vars；本機要連 sandbox 時在此覆寫。
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_API_BASE=https://sandbox.affiliate.1wayseo.com
PAYMENT_SITE_CODE=IPAS

# cf-email 中繼的 API key（EMAIL_PROVIDER=cf-email 時需要；來源見 docs/payments.md「Email」）。
# 本機開發可不填，設 EMAIL_PROVIDER=console 改印在終端機。
CF_EMAIL_API_KEY=
EMAIL_PROVIDER=console

# 擁有者（管理員）Email，逗號分隔；用於標記退款的 /api/admin/*。倉庫為公開，勿寫進 wrangler.app.jsonc 的 vars，
# 正式環境以 `printf "%s" "<管理員 Email>" | npx wrangler secret put ADMIN_EMAILS -c wrangler.app.jsonc` 設定。
ADMIN_EMAILS=admin@example.com
